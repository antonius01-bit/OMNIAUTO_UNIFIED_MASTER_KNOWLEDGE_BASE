@echo off
chcp 65001 >nul
title STARK INDUSTRIES — SHUTDOWN GATE
cd /d "C:\Users\antoni\Dola"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$activeTasksCount = 0; $tasks = @(); try { $s = Invoke-RestMethod -Uri 'http://127.0.0.1:5050/api/tasks/status' -TimeoutSec 2 -ErrorAction Stop; $activeTasksCount = $s.active_tasks_count; $tasks = $s.tasks } catch { Write-Host '[*] Server Port 5050 sudah dalam kondisi OFFLINE.' -ForegroundColor Yellow; Start-Sleep -Seconds 1; exit 0 }; if ($activeTasksCount -gt 0) { Write-Host \"`n[!] PERINGATAN: Masih ada $activeTasksCount tugas agen yang SEDANG BERJALAN!\" -ForegroundColor Yellow; foreach ($t in $tasks) { Write-Host \"    ▹ [$($t.id)] $($t.name) ($($t.started_at))\" -ForegroundColor Gray }; Write-Host ''; $c = Read-Host 'Do you really want to exit? (Y/N)'; if ($c.Trim().ToUpper() -ne 'Y') { Write-Host '[✓] Pembatalan keluar. Server tetap aktif.' -ForegroundColor Green; Start-Sleep -Seconds 2; exit 0 } } else { Write-Host '`n[*] Tidak ada tugas aktif yang berjalan. Mematikan sistem...' -ForegroundColor Cyan }; Write-Host '[*] Mematikan Bridge Server Port 5050...' -ForegroundColor Cyan; try { Invoke-RestMethod -Uri 'http://127.0.0.1:5050/api/shutdown?force=true' -TimeoutSec 2 -ErrorAction SilentlyContinue } catch {}; $conns = Get-NetTCPConnection -LocalPort 5050 -ErrorAction SilentlyContinue; if ($conns) { $pids = $conns | Select-Object -ExpandProperty OwningProcess -Unique; foreach ($p in $pids) { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue } }; if (Test-Path 'speak_jarvis.vbs') { Start-Process 'wscript' -ArgumentList '\"speak_jarvis.vbs\"', '\"Powering down systems. Goodbye, sir.\"' -WindowStyle Hidden }; Write-Host '[✓] Server Port 5050 berhasil dimatikan secara bersih. Goodbye, sir.`n' -ForegroundColor Green; Start-Sleep -Seconds 1"
